[
 {
  "name": "Eye Quotation",
  "docstatus": 0,
  "idx": 0,
  "print_format_for": "DocType",
  "doc_type": "Quotation",
  "report": null,
  "module": "Eye CRM",
  "default_print_language": null,
  "preview_image": null,
  "standard": "No",
  "custom_format": 1,
  "disabled": 0,
  "pdf_generator": "wkhtmltopdf",
  "print_format_type": "Jinja",
  "raw_printing": 0,
  "html": "<meta name=\"pdfkit-page-width\" content=\"338.67mm\">\n<meta name=\"pdfkit-page-height\" content=\"190.5mm\">\n<meta name=\"pdfkit-margin-top\" content=\"0mm\">\n<meta name=\"pdfkit-margin-bottom\" content=\"0mm\">\n<meta name=\"pdfkit-margin-left\" content=\"0mm\">\n<meta name=\"pdfkit-margin-right\" content=\"0mm\">\n{%- set IMG = \"/assets/eye_crm/images/quotation/\" -%}\n{%- set by_name = frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner -%}\n{%- set contact_name = doc.contact_display or (frappe.db.get_value(\"Contact\", doc.contact_person, \"full_name\") if doc.contact_person else \"\") -%}\n{%- set cur = doc.currency -%}\n<style>\n  .print-format { margin-top: 0mm; margin-bottom: 0mm; margin-left: 0mm; margin-right: 0mm; page-size: Custom; page-width: 338.67mm; page-height: 190.5mm; }\n  @page { size: 338.67mm 190.5mm; margin: 0; }\n  html, body { margin: 0 !important; padding: 0 !important; }\n  .print-format { padding: 0 !important; margin: 0 !important; max-width: none !important; width: auto !important; }\n  .slide { width: 338.67mm; height: 190.5mm; position: relative; overflow: hidden;\n           page-break-after: always; page-break-inside: avoid; }\n  .slide:last-child { page-break-after: auto; }\n  .bg { position: absolute; top: 0; left: 0; width: 338.67mm; height: 190.5mm; }\n  .t  { position: absolute; font-family: Arial, Helvetica, sans-serif; line-height: 1.15; }\n  .w  { color: #fff; }\n\n  table.q { position: absolute; top: 36mm; left: 28.3mm; width: 272.8mm;\n            border-collapse: separate; border-spacing: 0.6mm;\n            font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #000; }\n  table.q td, table.q th { text-align: center; vertical-align: middle; padding: 0 2mm; height: 11.5mm; }\n  table.q th { background: #16A7DF; color: #fff; font-weight: normal; }\n  table.q td.desc { text-align: left; font-weight: bold; }\n  table.q td.desc p, table.q td.desc div { margin: 0; padding: 0; }\n  table.q tr.item td { background: #EDEDED; }\n  table.q tr.sum td.lbl { background: transparent; }\n  table.q tr.sum td.val { color: #fff; font-weight: bold; background: #002060; }\n  table.q tr.sum.tax td.val { background: #16A7DF; }\n</style>\n\n<!-- 1. Cover -->\n<div class=\"slide\">\n  <img class=\"bg\" src=\"{{ IMG }}slide-1.jpg\">\n  <div class=\"t w\" style=\"top:72mm; left:25mm; width:165mm; font-size:34pt;\">{{ contact_name or doc.customer_name }}</div>\n  <div class=\"t w\" style=\"top:104mm; left:25.5mm; width:165mm; font-size:14pt;\">{{ doc.custom_quotation_title or \"Quotation\" }}</div>\n  <div class=\"t w\" style=\"top:113mm; left:25.5mm; width:165mm; font-size:12pt;\">No. {{ doc.name }} · {{ frappe.utils.formatdate(doc.transaction_date) }}</div>\n</div>\n\n<!-- 2. To / Company / By -->\n<div class=\"slide\">\n  <img class=\"bg\" src=\"{{ IMG }}slide-2.jpg\">\n  <div class=\"t w\" style=\"top:62.5mm; left:72mm; width:125mm; font-size:22pt;\">{{ contact_name }}</div>\n  <div class=\"t w\" style=\"top:88.5mm; left:72mm; width:125mm; font-size:22pt;\">{{ doc.customer_name }}</div>\n  <div class=\"t w\" style=\"top:114.5mm; left:72mm; width:125mm; font-size:22pt;\">{{ by_name }}</div>\n</div>\n\n<!-- 3. Client references (static) -->\n<div class=\"slide\"><img class=\"bg\" src=\"{{ IMG }}slide-3.jpg\"></div>\n\n<!-- 4. Pricing: 7 items per slide, totals on the last one -->\n{%- set pages = doc.items | batch(7) | list -%}\n{%- for chunk in pages %}\n<div class=\"slide\">\n  <img class=\"bg\" src=\"{{ IMG }}slide-4.jpg\">\n  <div class=\"t\" style=\"top:29mm; left:28.3mm; font-size:10pt; color:#002060;\">Quotation No. {{ doc.name }}</div>\n  <table class=\"q\">\n    <colgroup><col style=\"width:47%\"><col style=\"width:11%\"><col style=\"width:21%\"><col style=\"width:21%\"></colgroup>\n    <tr><th>Description</th><th>Quantity</th><th>Unit Price ({{ cur }})</th><th>Total Price ({{ cur }})</th></tr>\n    {%- for i in chunk %}\n    <tr class=\"item\">\n      <td class=\"desc\">{{ i.description or i.item_name }}</td>\n      <td>{{ frappe.utils.fmt_money(i.qty, precision=0) }}</td>\n      <td>{{ frappe.utils.fmt_money(i.rate, currency=None) }}</td>\n      <td>{{ frappe.utils.fmt_money(i.amount, currency=None) }}</td>\n    </tr>\n    {%- endfor %}\n    {%- if loop.last %}\n    <tr class=\"sum\"><td class=\"lbl\">Total</td><td class=\"val\" colspan=\"3\">{{ doc.get_formatted(\"net_total\") }}</td></tr>\n    {%- for tx in doc.taxes %}\n    <tr class=\"sum tax\"><td class=\"lbl\"><b>{{ tx.description }}</b></td><td class=\"val\" colspan=\"3\">{{ tx.get_formatted(\"tax_amount\", doc) }}</td></tr>\n    {%- endfor %}\n    {%- if doc.taxes %}\n    <tr class=\"sum\"><td class=\"lbl\">Grand Total</td><td class=\"val\" colspan=\"3\">{{ doc.get_formatted(\"grand_total\") }}</td></tr>\n    {%- endif %}\n    {%- endif %}\n  </table>\n</div>\n{%- endfor %}\n\n<!-- 5. Concurrence -->\n<div class=\"slide\">\n  <img class=\"bg\" src=\"{{ IMG }}slide-5.jpg\">\n  <div class=\"t\" style=\"top:65.6mm; left:197.2mm; width:135mm; font-size:18pt; font-weight:bold; color:#16A7DF;\">{{ doc.customer_name }}</div>\n</div>\n\n<!-- 6. Terms (static, last heading fixed to Taxes) -->\n<div class=\"slide\"><img class=\"bg\" src=\"{{ IMG }}slide-6.jpg\"></div>\n\n<!-- 7. Our services (static) -->\n<div class=\"slide\"><img class=\"bg\" src=\"{{ IMG }}slide-7.jpg\"></div>\n\n<!-- 8. Thank you (static) -->\n<div class=\"slide\"><img class=\"bg\" src=\"{{ IMG }}slide-8.jpg\"></div>\n",
  "raw_commands": null,
